generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_sessions {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int       @db.UnsignedInt
  token_hash String    @unique(map: "token_hash") @db.Char(64)
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_sessions_user")

  @@index([user_id], map: "fk_admin_sessions_user")
}

model bookings {
  id            Int             @id @default(autoincrement()) @db.UnsignedInt
  booking_code  String          @unique(map: "booking_code") @db.VarChar(50)
  user_id       Int             @db.UnsignedInt
  package_id    Int?            @db.UnsignedInt
  package_name  String          @db.VarChar(100)
  visit_date    DateTime        @db.Date
  visitor_count Int             @default(1) @db.UnsignedInt
  total_amount  Decimal         @db.Decimal(12, 2)
  status        bookings_status @default(pending)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @default(now()) @db.Timestamp(0)
  packages      packages?       @relation(fields: [package_id], references: [id], map: "fk_bookings_package")
  users         users           @relation(fields: [user_id], references: [id], map: "fk_bookings_user")
  payments      payments?

  @@index([package_id], map: "fk_bookings_package")
  @@index([user_id], map: "fk_bookings_user")
}

model packages {
  id          Int             @id @default(autoincrement()) @db.UnsignedInt
  name        String          @db.VarChar(100)
  description String?         @db.Text
  price       Decimal         @db.Decimal(12, 2)
  status      packages_status @default(active)
  created_at  DateTime?       @default(now()) @db.Timestamp(0)
  updated_at  DateTime?       @default(now()) @db.Timestamp(0)
  bookings    bookings[]
}

model payments {
  id               Int             @id @default(autoincrement()) @db.UnsignedInt
  booking_id       Int             @unique(map: "booking_id") @db.UnsignedInt
  payment_method   String          @db.VarChar(50)
  amount           Decimal         @db.Decimal(12, 2)
  proof_path       String?         @db.VarChar(255)
  status           payments_status @default(pending)
  verified_by      Int?            @db.UnsignedInt
  verified_at      DateTime?       @db.DateTime(0)
  rejection_reason String?         @db.Text
  created_at       DateTime?       @default(now()) @db.Timestamp(0)
  updated_at       DateTime?       @default(now()) @db.Timestamp(0)
  users            users?          @relation(fields: [verified_by], references: [id], map: "fk_payments_admin")
  bookings         bookings        @relation(fields: [booking_id], references: [id], map: "fk_payments_booking")

  @@index([verified_by], map: "fk_payments_admin")
}

model users {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  name           String           @db.VarChar(100)
  email          String           @unique(map: "email") @db.VarChar(150)
  password       String           @db.VarChar(255)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @default(now()) @db.Timestamp(0)
  role           users_role       @default(user)
  status         users_status     @default(active)
  admin_sessions admin_sessions[]
  bookings       bookings[]
  payments       payments[]
}

enum packages_status {
  active
  inactive
}

enum payments_status {
  pending
  verified
  rejected
}

enum users_role {
  admin
  user
}

enum users_status {
  active
  inactive
  blocked
}

enum bookings_status {
  pending
  confirmed
  cancelled
}
